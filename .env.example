# Copy this file to .env and adjust. .env is not committed.
# Values below are for local development only.

# PostgreSQL
POSTGRES_DB=ivpds
POSTGRES_USER=ivpds
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# MinIO (password must be at least 8 characters)
MINIO_ROOT_USER=ivpds
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend
BACKEND_PORT=8080
# Bucket for call audio; created by the backend at startup if missing.
STORAGE_BUCKET=ivpds-audio
# Signing key for access tokens: at least 32 random characters. Generate your own, never reuse this one.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# First ADMIN account, created at startup if it does not exist. Leave empty to skip.
ADMIN_EMAIL=admin@ivpds.local
ADMIN_PASSWORD=change-me-min-8-chars

# AI service
AI_PORT=8000
# Shared secret between the backend and the AI service: at least 16 random characters.
AI_API_KEY=change-me-to-a-random-string
# Speech-to-text uses PhoWhisper-medium (Whisper fine-tuned for Vietnamese). It is built into the ai
# image, so there is nothing to download or configure: "docker compose up -d --build" is enough.
# The first build downloads about 3 GB and takes several minutes.
# CPU threads for speech-to-text; 0 lets the library choose (4). Raise it on machines with more cores.
AI_WHISPER_CPU_THREADS=0
# Fine-tuned NLP model to serve: the name of a folder in ai/models/ (produced by ai/training, not stored in git).
# If the folder is missing the service still starts and reports the NLP model as UNAVAILABLE.
AI_NLP_MODEL_NAME=phobert-base-r6

# Mail. Leave MAIL_HOST unset to capture mail in Mailpit (open http://localhost:8025 to read it).
# To send real mail, set the SMTP server of your provider, e.g. Gmail with an app password:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USER=you@gmail.com
#   MAIL_PASSWORD="your app password"
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@ivpds.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
